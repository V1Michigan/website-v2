# Add these to .env.local or your hosting environment. Do not put real keys here.
# Keep the website's existing NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY. No second Supabase project is needed.

# Required for database operations; use the SAME website Supabase project.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI recommendations. Manual recommendations work without this.
ANTHROPIC_API_KEY=

# Optional: send match emails from a verified Resend sender.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: authenticated scheduled POST /api/startup-week/matches/notify.
CRON_SECRET=

# Required when connecting Tally to /api/startup-week/tally/webhook.
TALLY_SIGNING_SECRET=

# Setup:
# 1. Apply supabase/migrations/20260929000100_startup_week.sql, then
#    supabase/migrations/20260929000200_startup_week_admins.sql.
# 2. In Supabase Table Editor, add each organizer's Google email (lowercase) to
#    public.startup_week_admins. Delete a row to revoke access immediately.
#    There is no admin email environment variable. Browser users cannot edit
#    the allowlist or grant themselves access.
# 3. Enable Google in Supabase Auth; allow these redirect URLs:
#    https://v1michigan.com/admin
#    https://v1michigan.com/startupweek/company/*
#    http://localhost:3000/admin
#    http://localhost:3000/startupweek/company/*
#    http://127.0.0.1:3000/admin
#    http://127.0.0.1:3000/startupweek/company/*
#    Add other actual local ports/origins if used.
# 4. Insert startups in public.startup_week_companies with name, slug,
#    contact_email, description. Contact email grants company portal access.
# 5. Connect the signed Tally webhook or migrate your existing student data.
#    Existing startup-fair data is NOT copied by the schema migration.
# 6. Give companies /startupweek/company/<slug> links to rank students.
# 7. Open /admin to curate recommendations, run matching, then send emails.
#
# Sending is explicit; migration, matching and AI suggestions do not send emails.
# Re-running matching adds missing pairs, without removing earlier matches.
# AI suggestions use name, major, school and grad year, not resume contents.
# If delivery is held for review, check Resend before clearing a claim in
# startup_week_matches; an interrupted request may already have sent the email.
